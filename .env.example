# Copie para `.env` e preencha com valores locais. NUNCA versione o `.env`.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unify
DB_USER=unify
DB_PASSWORD=troque-esta-senha

# --- SMTP / Mailtrap (sandbox de e-mail para dev) ---
# Em dev, `quarkus.mailer.mock=true` faz os e-mails serem apenas logados;
# estes valores so passam a ser usados quando o mock for desligado.
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=preencher
MAILTRAP_PASSWORD=preencher
MAILTRAP_FROM=nao-responda@unify.com.br

# --- Frontend ---
# URL para onde o e-mail de redefinicao de senha aponta.
FRONTEND_PASSWORD_RESET_URL=http://localhost:8081/reset-password
# Origens permitidas pelo CORS, separadas por virgula.
FRONTEND_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# --- Chaves JWT (ver secao 2.2 do plano de implementacao) ---
# Caminhos FORA de src/main/resources. As chaves nunca sao empacotadas.
JWT_PRIVATE_KEY_LOCATION=file:./secrets/privateKey.pem
JWT_PUBLIC_KEY_LOCATION=file:./secrets/publicKey.pem
